# Copy to `.env` and change the values.
SECRET=a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# reCAPTCHA v3: if empty, the /contact endpoint doesn't check the token (handy locally).
RECAPTCHA_SECRET=
# Minimum reCAPTCHA v3 score to accept a message.
RECAPTCHA_MIN_SCORE=0.5

# Where form messages are delivered.
CONTACT_EMAIL_TO=info@leicaflorianrobert.dev

# The Coolify deploy webhook that rebuilds the static site. Empty locally.
DEPLOY_WEBHOOK_URL=

# Email sending (see the Directus docs, EMAIL_*). Not needed locally.
EMAIL_FROM=no-reply@leicaflorianrobert.dev
EMAIL_TRANSPORT=sendmail
