# The Directus URL the site reads content and images from.
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
# The reCAPTCHA v3 public key. Empty: the form is sent without reCAPTCHA.
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
# The CookieYes site id, from its install snippet. Empty: no consent banner, the form works without asking.
NUXT_PUBLIC_COOKIEYES_ID=
